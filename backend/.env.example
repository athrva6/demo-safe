APP_MODE=local
SCAN_PROVIDER=manual
AWS_DEFAULT_REGION=ap-south-1
LOCAL_DATA_DIR=.local
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# To opt in to real AWS scans: configure AWS CLI credentials, then set
# SCAN_PROVIDER=rekognition. This sends the selected image to AWS and incurs usage.
# Never put AWS credentials in frontend variables or commit them.
